# Copy this file to .env and fill in your key:
#
#     cp .env.example .env
#
# .env is gitignored; this template is not. Never put a real key in here.
#
# Only the generation stage needs this. Corpus loading, chunking, embedding,
# retrieval, and retrieval scoring all run without any credentials.
#
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=
